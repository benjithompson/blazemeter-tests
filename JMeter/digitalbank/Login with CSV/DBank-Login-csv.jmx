        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

// Get the directory where the .jmx file is located
String baseDir = FileServer.getFileServer().getBaseDir()

// Build the full path to your CSV file
String csvPath = baseDir + File.separator + &quot;userlogin.csv&quot;

// Count lines (subtract 1 for header)
int rowCount = new File(csvPath).readLines().size()

// Set as property
props.put(&quot;threadCount&quot;, String.valueOf(rowCount))

log.info(&quot;CSV path: &quot; + csvPath)
log.info(&quot;Thread count set to: &quot; + rowCount)
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
      </hashTree>
